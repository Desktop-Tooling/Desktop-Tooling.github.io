{
  "schemaVersion": 1,
  "namespace": "thumbelina-live-iso",
  "source": {
    "kind": "mermaid",
    "uri": "mock-live-iso.mmd",
    "generator": "@mermaid-js/mermaid-cli"
  },
  "tokens": [
    { "id": "color.canvas", "description": "Diagram background" },
    { "id": "color.partition.esp", "description": "EFI system partition" },
    { "id": "color.partition.esp-border", "description": "EFI partition outline" },
    { "id": "color.partition.exfat", "description": "Windows-readable exFAT partition" },
    { "id": "color.partition.exfat-border", "description": "exFAT partition outline" },
    { "id": "color.text.on-partition", "description": "Partition label text" }
  ],
  "defaultPreset": "thumbelina",
  "presets": {
    "thumbelina": {
      "color.canvas": "#f8fafc",
      "color.partition.esp": "#3d5a80",
      "color.partition.esp-border": "#27415f",
      "color.partition.exfat": "#0b6e4f",
      "color.partition.exfat-border": "#07543d",
      "color.text.on-partition": "#ffffff"
    }
  },
  "paletteOverrides": {
    "dark": {
      "color.canvas": "#1e1f22",
      "color.partition.esp": "#5277a6",
      "color.partition.esp-border": "#86a9d2",
      "color.partition.exfat": "#117b5b",
      "color.partition.exfat-border": "#61c49f",
      "color.text.on-partition": "#ffffff"
    }
  },
  "bindings": [
    { "kind": "inline-style", "selector": "svg", "property": "background-color", "token": "color.canvas" },
    { "kind": "stylesheet", "selector": "#my-svg .esp rect", "property": "fill", "token": "color.partition.esp" },
    { "kind": "stylesheet", "selector": "#my-svg .esp rect", "property": "stroke", "token": "color.partition.esp-border" },
    { "kind": "stylesheet", "selector": "#my-svg .esp tspan", "property": "fill", "token": "color.text.on-partition" },
    { "kind": "stylesheet", "selector": "#my-svg .exfat rect", "property": "fill", "token": "color.partition.exfat" },
    { "kind": "stylesheet", "selector": "#my-svg .exfat rect", "property": "stroke", "token": "color.partition.exfat-border" },
    { "kind": "stylesheet", "selector": "#my-svg .exfat tspan", "property": "fill", "token": "color.text.on-partition" }
  ],
  "fallback": {
    "unresolvedToken": "error",
    "missingTarget": "error"
  }
}
